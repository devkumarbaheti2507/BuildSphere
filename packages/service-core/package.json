{
  "name": "@buildsphere/service-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@buildsphere/shared-types": "workspace:*",
    "express": "^4.21.1",
    "pg": "^8.22.0",
    "pino": "^9.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3"
  }
}
