# BuildSphere root environment example
NODE_ENV=development
LOG_LEVEL=debug
STORAGE_DRIVER=postgres

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=buildsphere
POSTGRES_USER=buildsphere
POSTGRES_PASSWORD=buildsphere_dev_password
DATABASE_URL=postgresql://buildsphere:buildsphere_dev_password@localhost:5432/buildsphere

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_TOKEN_SECRET=replace_with_local_dev_secret
JWT_REFRESH_TOKEN_SECRET=replace_with_local_dev_secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# GitHub App integration (Email read, Administration/Contents/Workflows write, Actions read)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/auth/github/callback
GITHUB_OAUTH_STATE_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_API_VERSION=2026-03-10

# Internal service authentication
INTERNAL_SERVICE_TOKEN=replace_with_local_internal_service_token

# Local service URLs
FRONTEND_URL=http://localhost:5173
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
PROJECT_SERVICE_URL=http://localhost:8082
PIPELINE_SERVICE_URL=http://localhost:8083
DEPLOYMENT_SERVICE_URL=http://localhost:8084
MONITORING_SERVICE_URL=http://localhost:8085
LOGGING_SERVICE_URL=http://localhost:8086
AI_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8089
PIPELINE_STAGE_DELAY_MS=700

# Controlled Kubernetes execution (disabled unless every required field is set)
KUBERNETES_EXECUTION_ENABLED=false
KUBERNETES_CREDENTIAL_ENCRYPTION_KEY=
KUBERNETES_ALLOWED_SERVER_HOSTS=
KUBERNETES_ALLOWED_ENVIRONMENTS=development
KUBERNETES_APPROVAL_TTL_SECONDS=300
KUBERNETES_REQUEST_TIMEOUT_MS=10000
KUBERNETES_OPERATION_TIMEOUT_MS=60000
KUBERNETES_MAX_ATTEMPTS=3

# AI provider placeholder
AI_PROVIDER=rules
AI_API_KEY=

# Object storage placeholder
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=buildsphere
S3_SECRET_KEY=buildsphere_dev_password
S3_BUCKET=buildsphere-artifacts
