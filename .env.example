# BuildSphere root environment example
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=buildsphere
POSTGRES_USER=buildsphere
POSTGRES_PASSWORD=buildsphere_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_TOKEN_SECRET=replace_with_local_dev_secret
JWT_REFRESH_TOKEN_SECRET=replace_with_local_dev_secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# AI provider placeholder
AI_PROVIDER=mock
AI_API_KEY=

# Object storage placeholder
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=buildsphere
S3_SECRET_KEY=buildsphere_dev_password
S3_BUCKET=buildsphere-artifacts
