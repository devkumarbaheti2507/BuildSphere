{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "labelSelector": {
      "type": "object",
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          }
        }
      }
    }
  },
  "required": [
    "publicUrl",
    "image",
    "runtime",
    "replicaCount",
    "terminationGracePeriodSeconds",
    "availability",
    "networkPolicy",
    "resources",
    "probes",
    "migration",
    "observability",
    "ingress",
    "deploymentExecution"
  ],
  "properties": {
    "publicUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "image": {
      "type": "object",
      "required": [
        "repositoryPrefix",
        "tag",
        "digestMode",
        "digests",
        "pullPolicy"
      ],
      "properties": {
        "repositoryPrefix": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "latest" }
        },
        "digestMode": { "type": "boolean" },
        "digests": {
          "type": "object",
          "required": [
            "api-gateway",
            "auth-service",
            "project-service",
            "pipeline-service",
            "deployment-service",
            "monitoring-service",
            "logging-service",
            "ai-service",
            "analytics-service",
            "notification-service",
            "frontend"
          ],
          "properties": {
            "api-gateway": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "auth-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "project-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "pipeline-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "deployment-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "monitoring-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "logging-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "ai-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "analytics-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "notification-service": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "frontend": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["existingSecret", "logLevel", "pipelineStageDelayMs"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "logLevel": {
          "type": "string",
          "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"]
        },
        "pipelineStageDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 300
    },
    "availability": {
      "type": "object",
      "required": [
        "rollout",
        "topologySpread",
        "podDisruptionBudget",
        "autoscaling"
      ],
      "properties": {
        "rollout": {
          "type": "object",
          "required": ["minReadySeconds", "maxUnavailable", "maxSurge"],
          "properties": {
            "minReadySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "maxSurge": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "topologySpread": {
          "type": "object",
          "required": ["enabled", "maxSkew", "topologyKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "topologyKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": {
              "type": "integer",
              "minimum": 1,
              "maximum": 49
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "cpuUtilizationPercentage",
            "memoryUtilizationPercentage",
            "scaleUpStabilizationWindowSeconds",
            "scaleDownStabilizationWindowSeconds"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "cpuUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "memoryUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "scaleUpStabilizationWindowSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "scaleDownStabilizationWindowSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressController", "metricsCollector"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" }
          }
        },
        "metricsCollector": {
          "type": "object",
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "serviceAnnotations",
        "serviceMonitor",
        "prometheusRule",
        "slo"
      ],
      "properties": {
        "serviceAnnotations": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled",
            "namespace",
            "additionalLabels",
            "interval",
            "scrapeTimeout"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "required": [
            "enabled",
            "namespace",
            "additionalLabels",
            "evaluationInterval"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "evaluationInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        },
        "slo": {
          "type": "object",
          "required": [
            "availabilityTargetPercent",
            "availabilityWindow",
            "serverErrorRatioAlertThreshold",
            "latencyTargetPercentile",
            "latencyTargetSeconds"
          ],
          "properties": {
            "availabilityTargetPercent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "availabilityWindow": {
              "type": "string",
              "pattern": "^[1-9][0-9]*d$"
            },
            "serverErrorRatioAlertThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "latencyTargetPercentile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "latencyTargetSeconds": {
              "type": "number",
              "enum": [0.1, 0.25, 0.5, 0.75, 1, 2.5, 5, 10]
            }
          }
        }
      }
    },
    "deploymentExecution": {
      "type": "object",
      "required": [
        "enabled",
        "allowedServerHosts",
        "allowedEnvironments",
        "approvalTtlSeconds",
        "requestTimeoutMs",
        "operationTimeoutMs",
        "maxAttempts"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedServerHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+):[0-9]{1,5}$"
          },
          "uniqueItems": true
        },
        "allowedEnvironments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["development", "staging", "production"]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "approvalTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "operationTimeoutMs": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 300000
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "allowedServerHosts": { "minItems": 1 },
              "allowedEnvironments": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
