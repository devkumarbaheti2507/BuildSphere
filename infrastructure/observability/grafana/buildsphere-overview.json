        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (service) (rate(buildsphere_http_requests_total{service=~\"$service\"}[5m]))",
