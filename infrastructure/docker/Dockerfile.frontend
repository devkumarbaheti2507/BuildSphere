# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.23.1-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
ARG NGINX_IMAGE=nginx:1.30.3-alpine-slim@sha256:d5b51cfc7d55fc7a7bcf4d1d577b9c3738331df56d68f0b1d8ac9795b9470a5a

FROM ${NODE_IMAGE} AS build
ARG VITE_API_URL=/api
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
RUN --mount=type=cache,id=buildsphere-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm fetch --frozen-lockfile

COPY . .
RUN --mount=type=cache,id=buildsphere-pnpm,target=/pnpm/store \
    case "${VITE_API_URL}" in \
      /*) ;; \
      *) echo "VITE_API_URL must be a same-origin absolute path" >&2; exit 64 ;; \
    esac && \
    pnpm install --offline --frozen-lockfile --filter "@buildsphere/frontend..." && \
    VITE_API_URL="${VITE_API_URL}" pnpm --filter "@buildsphere/frontend..." build

FROM ${NGINX_IMAGE} AS runtime
ARG BUILD_VERSION=development
ARG BUILD_REVISION=unknown
ARG BUILD_SOURCE=https://github.com/devkumarbaheti2507/BuildSphere
ARG BUILD_LICENSES=MIT

LABEL org.opencontainers.image.title="BuildSphere frontend" \
  org.opencontainers.image.source="${BUILD_SOURCE}" \
  org.opencontainers.image.revision="${BUILD_REVISION}" \
  org.opencontainers.image.version="${BUILD_VERSION}" \
  org.opencontainers.image.licenses="${BUILD_LICENSES}"

COPY infrastructure/nginx/frontend.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
