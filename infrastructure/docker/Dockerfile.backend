# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.23.1-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2

FROM ${NODE_IMAGE} AS build
ARG SERVICE
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
RUN --mount=type=cache,id=buildsphere-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm fetch --frozen-lockfile

COPY . .
RUN --mount=type=cache,id=buildsphere-pnpm,target=/pnpm/store \
    case "${SERVICE}" in \
      ai-service|analytics-service|api-gateway|auth-service|deployment-service|logging-service|monitoring-service|notification-service|pipeline-service|project-service) ;; \
      *) echo "Unsupported SERVICE: ${SERVICE}" >&2; exit 64 ;; \
    esac && \
    pnpm install --offline --frozen-lockfile --filter "@buildsphere/${SERVICE}..." && \
    pnpm --filter "@buildsphere/${SERVICE}..." build && \
    pnpm --filter "@buildsphere/${SERVICE}" deploy --prod /workspace/deploy

FROM ${NODE_IMAGE} AS runtime
ARG SERVICE
ARG SERVICE_PORT=8080
ARG BUILD_VERSION=development
ARG BUILD_REVISION=unknown
ARG BUILD_SOURCE=https://github.com/devkumarbaheti2507/BuildSphere
ARG BUILD_LICENSES=MIT
ENV NODE_ENV=production
ENV BUILDSPHERE_ROOT=/app
ENV SERVICE_NAME=${SERVICE}
ENV PORT=${SERVICE_PORT}
WORKDIR /app

LABEL org.opencontainers.image.title="BuildSphere ${SERVICE}" \
  org.opencontainers.image.source="${BUILD_SOURCE}" \
  org.opencontainers.image.revision="${BUILD_REVISION}" \
  org.opencontainers.image.version="${BUILD_VERSION}" \
  org.opencontainers.image.licenses="${BUILD_LICENSES}"

RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /opt/yarn-v1.22.22 && \
    rm -f \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg

COPY --from=build --chown=node:node /workspace/deploy ./
COPY --from=build --chown=node:node /workspace/templates ./templates
COPY --from=build --chown=node:node /workspace/prompts ./prompts
COPY --from=build --chown=node:node /workspace/infrastructure/database/migrations ./infrastructure/database/migrations

USER node
EXPOSE ${SERVICE_PORT}
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["node", "dist/index.js"]
